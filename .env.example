# 必須: Discord Bot トークン
DISCORD_TOKEN=your_discord_bot_token
# 任意: 指定するとスラッシュコマンドをそのギルドに即時登録
DISCORD_GUILD_ID=
VOICEVOX_BASE_URL=http://127.0.0.1:50021
DEFAULT_SPEAKER=1
DEFAULT_SPEED_SCALE=1.2
# 任意: 抑揚（1.0標準、1.1〜1.2で表現豊か）
VOICEVOX_INTONATION_SCALE=1.0
# 任意: 音高（0標準、-0.15〜0.15）
VOICEVOX_PITCH_SCALE=0
# 任意: 読点などの間の長さ（1.0標準）
VOICEVOX_PAUSE_LENGTH_SCALE=1.0
SPEAKER_CACHE_TTL_MS=300000
VOICEVOX_FETCH_TIMEOUT_MS=10000
# 任意: 起動時に先読みする話者数（0で無効、1でデフォルト話者のみ）
VOICEVOX_PREWARM_LIMIT=4
# 任意: /streaming_synthesis による低遅延再生（false で従来の一括合成）
VOICEVOX_STREAMING_SYNTHESIS=true
MAX_QUEUE_SIZE=50
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_MS=10000
